{
	"name": "abandoned-but-not-forgotten",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.18.0"
	},
	"scripts": {
		"dev": "vite --host 127.0.0.1",
		"build": "npm run licenses:generate && vite build",
		"preview": "vite preview --host 127.0.0.1",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "node --test tests/data.test.ts",
		"test:e2e": "playwright test",
		"test:links": "node scripts/check-links.mjs",
		"format:check": "prettier --check .",
		"media:fetch": "node scripts/fetch-media.mjs",
		"sources:generate": "node scripts/generate-sources.mjs",
		"verify:challenge": "node scripts/verify-challenge.mjs",
		"licenses:generate": "node scripts/generate-notices.mjs",
		"demo:record": "node scripts/record-demo.mjs",
		"demo:verify": "node scripts/verify-demo.mjs"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.0",
		"@fontsource-variable/space-grotesk": "^5.2.0",
		"d3-geo": "^3.1.1",
		"@lucide/svelte": "^1.73.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.56.1",
		"@sveltejs/adapter-static": "^3.0.11",
		"@sveltejs/kit": "^2.70.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/vite": "^4.1.0",
		"@types/d3-geo": "^3.1.0",
		"@types/node": "^24.0.0",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^4.1.0",
		"typescript": "~5.9.3",
		"vite": "^7.3.0"
	},
	"overrides": {
		"cookie": "^0.7.2"
	}
}
