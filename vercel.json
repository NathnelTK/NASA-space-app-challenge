{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": "sveltekit",
	"buildCommand": "npm run build",
	"outputDirectory": "build",
	"installCommand": "npm ci",
	"cleanUrls": true,
	"trailingSlash": true,
	"headers": [
		{
			"source": "/demo/(.*)",
			"headers": [
				{ "key": "Cache-Control", "value": "public, max-age=3600" },
				{ "key": "X-Content-Type-Options", "value": "nosniff" }
			]
		}
	]
}
